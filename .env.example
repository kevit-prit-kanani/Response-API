# ZenRows
ZENROWS_API_KEY=your_zenrows_api_key

# OpenAI
OPENAI_API_KEY=your_openai_api_key
OPENAI_CHAT_MODEL=gpt-5.6-sol

# MongoDB
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>/
MONGODB_DB=RAG_assessment
MONGODB_SESSIONS_COLLECTION=sessions
MONGODB_CHAT_COLLECTION=chat

# Langfuse
LANGFUSE_PUBLIC_KEY=your_langfuse_public_key
LANGFUSE_SECRET_KEY=your_langfuse_secret_key
LANGFUSE_BASE_URL=https://cloud.langfuse.com

# Optional: set the API key to route LiteLLM completions through a proxy.
# LITELLM_PROXY_API_KEY=your_litellm_proxy_api_key
# LITELLM_PROXY_API_BASE=http://localhost:4000
